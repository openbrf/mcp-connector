{
  "name": "@openbrf/mcp-connector",
  "version": "0.1.0",
  "description": "MCP Connector for Open BRF: an MCP client signs in as a member and acts through the instance's armed actions.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbrf/mcp-connector.git"
  },
  "files": [
    "dist",
    "locales"
  ],
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "node scripts/check-package.mjs"
  },
  "openbrf": {
    "apiVersion": 1,
    "id": "mcp-connector",
    "entry": {
      "server": "./dist/server.cjs",
      "client": "./dist/remoteEntry.js"
    },
    "view": {
      "module": "./View",
      "titleKey": "view.title",
      "section": "board"
    },
    "permissions": [],
    "personalData": [],
    "actions": [],
    "oauthProtectedResource": "mcp",
    "licence": {
      "entitlement": "mcp-connector",
      "issuer": {
        "name": "Apteo AB",
        "url": "https://apteo.se"
      },
      "keys": {
        "unissued": "0I5fmnkqYBfyF3spwOWp9ODzk5NtcS4iYRnTpC1YOH0="
      },
      "audiences": []
    },
    "released": "2026-10-20"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@module-federation/vite": "1.23.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@openbrf/plugin-sdk": "1.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "fastify": "5.12.5",
    "i18next": "26.5.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
